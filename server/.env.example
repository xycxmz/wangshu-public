# hub 监听地址
HUB_ADDR=:10440

# 数据库 DSN：postgres:// 或 postgresql:// 开头走 PostgreSQL；否则按 sqlite 文件 DSN
# ⚠ docker compose 部署时无需设置：compose 的 environment 段已钉死容器内值（指向 pg 服务）
HUB_DSN=file:hub.db

# account-center API 基址（登录代理目标）
CENTER_URL=https://account.secai.fun

# account-center JWKS 端点（hub 拉取验签公钥）
CENTER_JWKS_URL=https://account.secai.fun/.well-known/jwks.json

# 在 account-center 注册的 appId，须与 access token 的 aud 一致
HUB_APP_ID=company-platform

# 可选：内联 JWKS JSON 兜底（center 启动时不可达也能验签）；留空禁用
CENTER_JWKS_JSON=

# 素材生成（DashScope 异步任务流）。DASHSCOPE_API_KEY 留空 ⇒ /api/v1/material 返回 503
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_API_KEY=
DASHSCOPE_IMAGE_MODEL=wanx2.1-t2i-turbo
DASHSCOPE_VIDEO_MODEL=wan2.2-t2v-plus

# 素材计价表："<model>,<cents_per_unit>"（图=每张；视频=每条，按 480P/5s 档估——
# wan2.2 按秒计费 0.14 元/s，若改提 1080P 请调 350）。model 须与实际提交模型名
# 一致才计价，不一致或缺失/非法 ⇒ 计 0（启动时 warn 一行）。价目：help.aliyun.com/zh/model-studio/model-pricing
MATERIAL_PRICE_IMAGE=wanx2.1-t2i-turbo,14
MATERIAL_PRICE_VIDEO=wan2.2-t2v-plus,700

# 自更新分发目录（manifest.json + assets/；未发版时该目录为空即可，hub 回 204）
# ⚠ compose 部署时由卷挂载钉死，本地单进程用默认值
HUB_UPDATE_DIR=updates

# 额外允许的 CORS origin（逗号分隔；Tauri webview 三 origin 已内置，一般留空）
HUB_CORS_ORIGINS=

# ⚠ 仅供 docker-compose 插值使用（PostgreSQL 密码）；单进程 sqlite 模式无需
HUB_PG_PASSWORD=
