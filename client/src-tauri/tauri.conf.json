{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wangshu",
  "version": "0.22.0",
  "identifier": "fun.secai.wangshu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "望舒",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 700,
        "resizable": true
      },
      {
        "label": "quickask",
        "url": "index.html#quick",
        "width": 480,
        "height": 320,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/assets/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://platform.secai.fun/api/v1/update/manifest"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA1RUU2Qjc5NUUyMzY3NzkKUldSNVp5TmVlV3Z1QmRXTzJLYmdWMU9Ya04zZ1VhNUdNbkFKbVNRSFVzekFBTjdUa3pEQkw1VHoK"
    }
  }
}
